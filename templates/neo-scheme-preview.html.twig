{#
/**
 * @file
 * Scheme preview: shows a frontend dev what applying `.scheme-*` gets them —
 * a real component sample (typography, the full button matrix, badges),
 * surface/elevation steps, and the four palette ramps.
 *
 * Color comes from inline `rgb(var(--color-*))` rather than Tailwind color
 * utilities, so this preview never forces generation of per-shade classes
 * (bg-base-0..950 etc.) that nothing else uses. Only the real button component
 * classes (.btn-*) are kept — those are the actual API a dev writes and are
 * already in the build from real components. Layout uses structural utilities
 * (flex/grid/spacing) which are shared everywhere.
 */
#}
{% set shades = [0, 50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950] %}
{% set ramps = [
  { key: 'base',      name: 'Base',      pallet: base },
  { key: 'primary',   name: 'Primary',   pallet: primary },
  { key: 'secondary', name: 'Secondary', pallet: secondary },
  { key: 'accent',    name: 'Accent',    pallet: accent },
] %}
{% set buttonRows = [
  { label: 'Solid',   btns: [
    { c: 'btn',                  t: '.btn' },
    { c: 'btn btn-primary',      t: '.btn-primary' },
    { c: 'btn btn-secondary',    t: '.btn-secondary' },
    { c: 'btn btn-accent',       t: '.btn-accent' },
  ] },
  { label: 'Outline', btns: [
    { c: 'btn btn-outline',           t: '.btn-outline' },
    { c: 'btn btn-outline-primary',   t: '.btn-outline-primary' },
    { c: 'btn btn-outline-secondary', t: '.btn-outline-secondary' },
    { c: 'btn btn-outline-accent',    t: '.btn-outline-accent' },
  ] },
  { label: 'Text',    btns: [
    { c: 'btn btn-text',           t: '.btn-text' },
    { c: 'btn btn-text-primary',   t: '.btn-text-primary' },
    { c: 'btn btn-text-secondary', t: '.btn-text-secondary' },
    { c: 'btn btn-text-accent',    t: '.btn-text-accent' },
  ] },
] %}
{%- set muted = 'opacity-60' -%}
{%- set hair = 'border-color: rgb(var(--color-base-200))' -%}

<div class="neo-scheme-preview {{ selector }} overflow-hidden rounded-lg border"
  style="background: rgb(var(--color-base-0)); color: rgb(var(--color-base-0-content)); {{ hair }}">

  {# ── Meta bar: dark / colorize flags + role→pallet mapping ── #}
  <div class="flex flex-wrap items-center justify-between gap-2 border-b px-4 py-2"
    style="background: rgb(var(--color-base-100)); color: rgb(var(--color-base-100-content)); {{ hair }}">
    <div class="flex flex-wrap items-center gap-1.5" style="font-size: 11px">
      <span class="rounded-full px-2 py-0.5 font-semibold uppercase tracking-wide"
        style="background: rgb(var(--color-base-200)); color: rgb(var(--color-base-200-content))">{{ dark ? 'Dark' : 'Light' }}</span>
      {% if colorize %}
        <span class="rounded-full px-2 py-0.5 font-semibold uppercase tracking-wide"
          style="background: rgb(var(--color-base-200)); color: rgb(var(--color-base-200-content))">Colorized{% if colorize_offset < 100 %} · {{ colorize_offset }}%{% endif %}</span>
      {% endif %}
    </div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 {{ muted }}" style="font-size: 11px">
      {% for r in ramps %}
        <span><span class="font-semibold">{{ r.name|lower }}</span> → {{ r.pallet }}</span>
      {% endfor %}
    </div>
  </div>

  {# ── Body: components (left) + surfaces (right) ── #}
  <div class="grid md:grid-cols-3">

    {# Components #}
    <div class="space-y-5 p-4 md:col-span-2">

      {# Typography #}
      <div>
        <div class="mb-1 font-semibold uppercase tracking-wider" style="font-size: 11px; color: var(--link-color, rgb(var(--color-primary-600)))">Eyebrow label</div>
        <div class="text-2xl font-bold leading-tight">Heading set in this scheme</div>
        <p class="mt-1 text-sm leading-relaxed">
          Body copy rendered on the scheme surface. Inline you get a
          <a href="#" class="font-medium underline" style="color: var(--link-color, rgb(var(--color-primary-600)))">text link</a>,
          its <a href="#" class="font-medium underline" style="color: var(--link-color-hover, rgb(var(--color-primary-800)))">hover color</a>,
          and <span class="{{ muted }}">muted supporting text</span> for hierarchy.
        </p>
      </div>

      {# Button matrix #}
      <div class="space-y-1.5">
        {# header row #}
        <div class="flex items-center gap-3">
          <span class="w-14 shrink-0"></span>
          <div class="grid grow grid-cols-4 gap-2 text-center font-semibold uppercase tracking-wide {{ muted }}" style="font-size: 10px">
            {% for r in ramps %}<span>{{ r.name }}</span>{% endfor %}
          </div>
        </div>
        {% for row in buttonRows %}
          <div class="flex items-center gap-3">
            <span class="w-14 shrink-0 font-semibold uppercase tracking-wide {{ muted }}" style="font-size: 10px">{{ row.label }}</span>
            <div class="grid grow grid-cols-4 gap-2">
              {% for b in row.btns %}
                <a class="{{ b.c }} btn-sm w-full truncate text-center" style="font-size: 11px">{{ b.t }}</a>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>

      {# Badges #}
      <div class="flex flex-wrap items-center gap-2" style="font-size: 11px">
        {% for r in ramps|filter(r => r.key != 'base') %}
          <span class="rounded px-2 py-0.5 font-medium"
            style="background: rgb(var(--color-{{ r.key }})); color: rgb(var(--color-{{ r.key }}-content))">{{ r.name }}</span>
        {% endfor %}
        <span class="rounded border px-2 py-0.5 font-medium" style="{{ hair }}">Tag</span>
        <span class="rounded-full px-2 py-0.5 font-medium"
          style="background: rgb(var(--color-base-200)); color: rgb(var(--color-base-200-content))">Muted pill</span>
      </div>
    </div>

    {# Surfaces + input #}
    <div class="space-y-3 border-t p-4 md:border-l md:border-t-0" style="{{ hair }}">
      <div class="font-semibold uppercase tracking-wide {{ muted }}" style="font-size: 10px">Surfaces &amp; elevation</div>

      {# Elevated card using the scheme's tinted shadow #}
      <div class="rounded-lg border p-3"
        style="background: rgb(var(--color-base-0)); color: rgb(var(--color-base-0-content)); {{ hair }}; box-shadow: 0 8px 20px -6px rgb(var(--color-shadow-500) / 0.45)">
        <div class="text-sm font-semibold">Card</div>
        <div class="{{ muted }}" style="font-size: 11px">base-0 + tinted shadow</div>

        <div class="mt-2 rounded-md border p-3"
          style="background: rgb(var(--color-base-100)); color: rgb(var(--color-base-100-content)); {{ hair }}">
          <div class="text-sm font-semibold">Panel</div>
          <div class="{{ muted }}" style="font-size: 11px">base-100</div>

          <div class="mt-2 rounded border p-2"
            style="background: rgb(var(--color-base-200)); color: rgb(var(--color-base-200-content)); {{ hair }}; font-size: 12px">
            Inset · base-200
          </div>
        </div>
      </div>

      {# Input #}
      <div>
        <div class="mb-1 font-medium {{ muted }}" style="font-size: 11px">Form input</div>
        <div class="rounded-md border-2 px-3 py-2"
          style="background: rgb(var(--color-base-0)); color: rgb(var(--color-base-0-content)); border-color: rgb(var(--color-base-300)); font-size: 13px">
          Placeholder<span class="{{ muted }}">&nbsp;text</span>
        </div>
      </div>
    </div>
  </div>

  {# ── Palette ramps ── #}
  <div class="space-y-2 border-t p-4" style="{{ hair }}">
    <div class="font-semibold uppercase tracking-wide {{ muted }}" style="font-size: 10px">Palette</div>
    {% for r in ramps %}
      <div class="flex items-center gap-3">
        <div class="w-20 shrink-0">
          <div class="text-xs font-semibold leading-none">{{ r.name }}</div>
          <div class="{{ muted }} leading-none" style="font-size: 10px">{{ r.key }}-*</div>
        </div>
        <div class="flex grow overflow-hidden rounded border" style="{{ hair }}">
          {% for sh in shades %}
            <div class="grow p-1 text-center {{ sh == 500 ? 'font-bold' : '' }}"
              style="font-size: 9px; background: rgb(var(--color-{{ r.key }}-{{ sh }})); color: rgb(var(--color-{{ r.key }}-{{ sh }}-content))">{{ sh }}</div>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
    {# Shadow ramp (base only) #}
    <div class="flex items-center gap-3">
      <div class="w-20 shrink-0">
        <div class="text-xs font-semibold leading-none">Shadow</div>
        <div class="{{ muted }} leading-none" style="font-size: 10px">shadow-*</div>
      </div>
      <div class="flex grow overflow-hidden rounded border" style="{{ hair }}">
        {% for sh in shades %}
          <div class="grow p-1 text-center" style="font-size: 9px; background: rgb(var(--color-shadow-{{ sh }})); color: rgba(255,255,255,0.85)">{{ sh }}</div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{{ css }}
